{
  "expo": {
    "name": "ATA Checador",
    "slug": "ata-checador",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "mx.serviciosata.checador",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ATA Checador usa tu ubicación para registrar dónde checas.",
        "NSFaceIDUsageDescription": "ATA Checador usa tu huella o rostro para confirmar que eres tú."
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-location",
      "expo-local-authentication"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
