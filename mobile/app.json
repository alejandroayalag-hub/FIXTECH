{
  "expo": {
    "name": "Fix Tech Checador",
    "slug": "fixtech-checador",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "mx.havocdev.fixtech.checador",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Fix Tech Checador usa tu ubicación para registrar dónde checas.",
        "NSFaceIDUsageDescription": "Fix Tech Checador usa tu huella o rostro para confirmar que eres tú."
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-location",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "90cec23c-af79-4d6f-9995-9e0cb7cd94df"
      }
    },
    "owner": "alxpho"
  }
}
